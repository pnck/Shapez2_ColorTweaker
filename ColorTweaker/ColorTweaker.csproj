<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Nullable>disable</Nullable>
		<RunPostBuildEvent>Always</RunPostBuildEvent>
		<LangVersion>10</LangVersion>
	</PropertyGroup>
	<PropertyGroup>
		<OutputPath>$(SPZ2_PERSISTENT)\mods\ColorTweaker</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
		<Reference Include="MonoMod.RuntimeDetour" Publicize="true">
			<HintPath>LibHints\MonoMod.RuntimeDetour.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="ShapezShifter" Publicize="true">
			<HintPath>LibHints\ShapezShifter.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="SPZGameAssembly" Publicize="true">
			<HintPath>$(SPZ2_PATH)\SPZGameAssembly.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Core" Publicize="true">
			<HintPath>$(SPZ2_PATH)\Core.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Game.Core" Publicize="true">
			<HintPath>$(SPZ2_PATH)\Game.Core.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Game.Content" Publicize="true">
			<HintPath>$(SPZ2_PATH)\Game.Content.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Game.Content.Features" Publicize="true">
			<HintPath>$(SPZ2_PATH)\Game.Content.Features.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- 颜色渲染：hook 颜色ID → RGBA 的映射 -->
		<Reference Include="Game.Core.Rendering" Publicize="true">
			<HintPath>$(SPZ2_PATH)\Game.Core.Rendering.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- 游戏内菜单和UI -->
		<Reference Include="Game.Interaction" Publicize="true">
			<HintPath>$(SPZ2_PATH)\Game.Interaction.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Game.Orchestration" Publicize="true">
			<HintPath>$(SPZ2_PATH)\Game.Orchestration.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- Mod 入口接口 -->
		<Reference Include="Game.Core.Modding">
			<HintPath>$(SPZ2_PATH)\Game.Core.Modding.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- Unity 基础类型 -->
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(SPZ2_PATH)\UnityEngine.CoreModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.ImageConversionModule">
			<HintPath>$(SPZ2_PATH)\UnityEngine.ImageConversionModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Unity.Mathematics">
			<HintPath>$(SPZ2_PATH)\Unity.Mathematics.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
	<!-- Publicizer：让 internal 成员对 mod 可见 -->
	<PropertyGroup>
		<PublicizerClearCacheOnClean>true</PublicizerClearCacheOnClean>
	</PropertyGroup>

	<ItemGroup>
		<None Update="manifest.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<Target Name="SteamPublish">
		<Exec Command='powershell -ExecutionPolicy Bypass -File "$(ProjectDir)Steam\SteamPublish.ps1" "$(OutputPath.TrimEnd(`\`))"' />
	</Target>

</Project>